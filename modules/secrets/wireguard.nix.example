{ ... }:

/*
  Copy this file to wireguard.nix and fill in the real values.

  cp modules/secrets/wireguard.nix.example modules/secrets/wireguard.nix

  wireguard.nix is gitignored. wireguard.nix.example is tracked.

  Interface name (e.g. wg-hamburg) becomes the Linux network interface.
  Max 15 characters, no spaces.

  privateKeyFile: Path to a file containing the base64 private key.
    privateKey is intentionally not used — NixOS would copy it into
    /nix/store which is world-readable.

    Generate a keypair:
      wg genkey | tee private.key | wg pubkey > public.key

    Write to the secrets dir (directory is created by systemd.tmpfiles on first rebuild):
      sudo mkdir -p /run/secrets/wireguard
      sudo tee /run/secrets/wireguard/pk-<name> <<< "BASE64_PRIVATE_KEY"
      sudo chmod 600 /run/secrets/wireguard/pk-<name>

    Note: the key ends up in shell history. Clear it afterward if that matters:
      history -d $(history 1)

  ips: CIDR addresses assigned to this device inside the tunnel.

  dns: Resolvers activated while the tunnel is up.
    Accepts IPs and hostnames (if the resolver itself is reachable via the tunnel).

  peers[].publicKey: Base64 public key of the remote peer. Safe to share.

  peers[].presharedKey: Symmetric PSK for an extra layer of encryption (optional but recommended).
    Generate: wg genpsk

  peers[].allowedIPs: Traffic destined for these CIDRs is routed into the tunnel.
    Use 0.0.0.0/0 + ::/0 to route all traffic (full tunnel / default gateway).

  peers[].endpoint: host:port of the remote peer. Only needed for the initiating side.

  peers[].persistentKeepalive: Send a keepalive every N seconds.
    Necessary when this device is behind NAT and needs to maintain the session.
    25 is a common value.
*/

{
  systemd.tmpfiles.rules = [ "d /run/secrets/wireguard 0700 root root -" ];

  networking.wireguard.interfaces.wg-example = {
    privateKeyFile = "/run/secrets/wireguard/pk-wg-example";

    ips = [
      "10.0.0.2/24"
      "fd00::2/64"
    ];

    dns = [
      "10.0.0.1"
      "fd00::1"
    ];

    peers = [
      {
        publicKey = "BASE64_PUBLIC_KEY_OF_PEER=";
        presharedKey = "BASE64_PRESHARED_KEY=";
        allowedIPs = [
          "10.0.0.0/24"
          "0.0.0.0/0"
          "fd00::/64"
          "::/0"
        ];
        endpoint = "vpn.example.com:51820";
        persistentKeepalive = 25;
      }
      # Additional peers follow the same structure.
      # {
      #   publicKey = "BASE64_PUBLIC_KEY_OF_PEER_2=";
      #   presharedKey = "BASE64_PRESHARED_KEY_2=";
      #   allowedIPs = [ "10.1.0.0/24" ];
      #   endpoint = "vpn2.example.com:51820";
      #   persistentKeepalive = 25;
      # }
    ];
  };
}
