# WireGuard conf template — copy to /etc/wireguard/wg-<name>.conf and fill in real values.
#
# Setup:
#   sudo mkdir -p /etc/wireguard
#   sudo cp modules/wireguard.conf.example /etc/wireguard/wg-hamburg.conf
#   sudo chmod 600 /etc/wireguard/wg-hamburg.conf
#   # fill in real keys, then import into NetworkManager (one-time):
#   sudo nmcli connection import type wireguard file /etc/wireguard/wg-hamburg.conf
#
# Generate a keypair:  wg genkey | tee private.key | wg pubkey
# Generate a PSK:      wg genpsk

[Interface]
PrivateKey = BASE64_PRIVATE_KEY=
Address = 10.0.0.2/24, fd00::2/64
DNS = 10.0.0.1, fd00::1

[Peer]
PublicKey = BASE64_PUBLIC_KEY_OF_PEER=
PresharedKey = BASE64_PRESHARED_KEY=
# AllowedIPs: specific CIDRs for split-tunnel, or 0.0.0.0/0,::/0 for full-tunnel.
AllowedIPs = 10.0.0.0/24, 0.0.0.0/0, fd00::/64, ::/0
Endpoint = vpn.example.com:51820
# PersistentKeepalive: required when behind NAT to maintain the session.
PersistentKeepalive = 25

# Additional peers: append more [Peer] blocks.
# [Peer]
# PublicKey = BASE64_PUBLIC_KEY_OF_PEER_2=
# PresharedKey = BASE64_PRESHARED_KEY_2=
# AllowedIPs = 10.1.0.0/24
# Endpoint = vpn2.example.com:51820
# PersistentKeepalive = 25
