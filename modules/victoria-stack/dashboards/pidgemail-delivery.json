{
  "uid": "pidgemail-delivery",
  "title": "Pidgemail delivery",
  "tags": [
    "pidgemail",
    "delivery"
  ],
  "editable": true,
  "schemaVersion": 41,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Now",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "In flight",
      "description": "Deliveries between a pipeline and the cluster.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(last_over_time(pidgemail_delivery_stage[30s])) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Deliveries in flight",
      "description": "One row per commit on its way to the cluster. The value counts seconds spent in the stage shown.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time(pidgemail_delivery_stage_seconds[30s])",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "project": true,
              "mr_url": true,
              "pipeline_url": true,
              "cluster": true,
              "k8s_node_name": true,
              "otel_scope_name": true,
              "service_name": true,
              "service_namespace": true
            },
            "indexByName": {
              "app": 0,
              "version": 1,
              "stage": 2,
              "Value": 3,
              "ref": 4,
              "author": 5,
              "sha": 6
            },
            "renameByName": {
              "Value": "seconds in stage"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "app"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "app"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Pipeline",
                    "url": "${__data.fields.pipeline_url}",
                    "targetBlank": true
                  },
                  {
                    "title": "Merge request",
                    "url": "${__data.fields.mr_url}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "seconds in stage"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "stat",
      "title": "Workloads short of replicas",
      "description": "Deployments answering with fewer replicas than asked for.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(last_over_time(pidgemail_deployed_ready[2m]) < last_over_time(pidgemail_deployed_desired[2m])) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Environments",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "table",
      "title": "Fleet",
      "description": "Every workload in the pidgemail namespaces, the version it runs, and how many replicas answer.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time(pidgemail_deployed_ready[2m])",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "last_over_time(pidgemail_deployed_desired[2m])",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "cluster": true,
              "instance": true,
              "job": true,
              "k8s_node_name": true,
              "otel_scope_name": true,
              "service_name": true,
              "service_namespace": true,
              "image": true,
              "url": true
            },
            "indexByName": {
              "namespace": 0,
              "workload": 1,
              "version": 2,
              "Value #A": 3,
              "Value #B": 4
            },
            "renameByName": {
              "Value #A": "ready",
              "Value #B": "desired"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "namespace"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "workload"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open",
                    "url": "${__data.fields.url}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "Review environments",
      "description": "One row per open merge request with a preview. Destroying a preview from here waits on the pull request generator.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time(pidgemail_preview_active[2m])",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "Value": true,
              "cluster": true,
              "k8s_node_name": true,
              "otel_scope_name": true,
              "service_name": true,
              "service_namespace": true
            },
            "indexByName": {
              "mr": 0,
              "branch": 1,
              "author": 2,
              "version": 3,
              "namespace": 4
            },
            "renameByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "mr"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open preview",
                    "url": "${__data.fields.url}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "type": "row",
      "title": "History",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Stage durations",
      "description": "Seconds each stage took, per delivery.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pidgemail_stage_duration_seconds",
          "legendFormat": "{{app}} {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "max"
          ]
        }
      }
    },
    {
      "type": "logs",
      "title": "Events",
      "description": "Every transition the tracker recorded, newest first.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{k8s.namespace.name=\"pidgemail-delivery\"}",
          "queryType": "instant",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ]
}
