            "uid": "victoriametrics"
          },
          "expr": "sum(increase(k8s_container_restarts{k8s_node_name=~\"$node\",k8s_namespace_name=~\"$namespace\",k8s_pod_name=~\"$pod\"}[$__range])) or vector(0)",
          "legendFormat": "",
