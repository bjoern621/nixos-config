    {
      "type": "table",
      "title": "Pods",
      "description": "Current resource use per pod against its limits. Near the CPU limit the pod gets throttled; at the memory limit the kernel kills it.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "sum by (k8s_namespace_name, k8s_pod_name, k8s_node_name) (last_over_time(k8s_pod_cpu_usage{k8s_node_name=~\"$node\",k8s_namespace_name=~\"$namespace\",k8s_pod_name=~\"$pod\"}[5m]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "100 * sum by (k8s_namespace_name, k8s_pod_name) (last_over_time(k8s_pod_cpu_usage{k8s_node_name=~\"$node\",k8s_namespace_name=~\"$namespace\",k8s_pod_name=~\"$pod\"}[5m])) / sum by (k8s_namespace_name, k8s_pod_name) (k8s_container_cpu_limit{k8s_namespace_name=~\"$namespace\",k8s_pod_name=~\"$pod\"})",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "sum by (k8s_namespace_name, k8s_pod_name) (last_over_time(k8s_pod_memory_working_set_bytes{k8s_node_name=~\"$node\",k8s_namespace_name=~\"$namespace\",k8s_pod_name=~\"$pod\"}[5m]))",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "100 * sum by (k8s_namespace_name, k8s_pod_name) (last_over_time(k8s_pod_memory_working_set_bytes{k8s_node_name=~\"$node\",k8s_namespace_name=~\"$namespace\",k8s_pod_name=~\"$pod\"}[5m])) / sum by (k8s_namespace_name, k8s_pod_name) (k8s_container_memory_limit_bytes{k8s_namespace_name=~\"$namespace\",k8s_pod_name=~\"$pod\"})",
          "legendFormat": "",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "sum by (k8s_namespace_name, k8s_pod_name) (increase(k8s_container_restarts{k8s_node_name=~\"$node\",k8s_namespace_name=~\"$namespace\",k8s_pod_name=~\"$pod\"}[$__range]))",
          "legendFormat": "",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
