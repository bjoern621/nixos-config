            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "sum(increase(container_oom_events_total{namespace=~\"$namespace\",pod=~\"$pod\"}[$__range])) or vector(0)",
          "legendFormat": "",
