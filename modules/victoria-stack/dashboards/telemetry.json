            "properties": [
              {
                "id": "displayName",
                "value": "Host"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "lines"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Lines"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": "",
          "countRows": false
        },
        "sortBy": []
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns",
            "valueLabel": "__name__"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "host.name": 0,
              "lines": 1
            },
            "renameByName": {}
          }
        }
      ],
      "gridPos": {
        "x": 4,
        "y": 5,
        "w": 4,
        "h": 8
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Export failures by exporter",
      "description": "Points and records per second each exporter failed to deliver.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "sum by (host_name, exporter) (label_copy(rate(otelcol_exporter_send_failed_metric_points_total[$__rate_interval]), \"k8s_pod_name\", \"host_name\")) > 0",
          "legendFormat": "{{host_name}} {{exporter}} metrics",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "sum by (host_name, exporter) (label_copy(rate(otelcol_exporter_send_failed_log_records_total[$__rate_interval]), \"k8s_pod_name\", \"host_name\")) > 0",
          "legendFormat": "{{host_name}} {{exporter}} logs",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "sum by (host_name, exporter) (label_copy(rate(otelcol_exporter_send_failed_spans_total[$__rate_interval]), \"k8s_pod_name\", \"host_name\")) > 0",
          "legendFormat": "{{host_name}} {{exporter}} spans",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": 120000,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "No failed export",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
