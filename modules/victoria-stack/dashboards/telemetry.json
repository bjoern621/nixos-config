      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "max(otelcol_exporter_queue_size / otelcol_exporter_queue_capacity)",
          "legendFormat": "",
          "refId": "A"
