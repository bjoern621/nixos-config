    {
      "id": 3,
      "type": "stat",
      "title": "pi-4b-hh",
      "description": "Host usage of the Raspberry Pi (backup target and observability replica), pushed by its telemetry agent. CPU is the non-idle share of all cores. Mem is used against total. Disk covers the root filesystem only; the external backup drive is not included.",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
