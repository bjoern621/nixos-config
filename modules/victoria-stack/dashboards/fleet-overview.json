        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - sum(rate(system_cpu_time_seconds_total{host_name=\"pi-4b-hh\",state=\"idle\"}[$__rate_interval])) / sum(rate(system_cpu_time_seconds_total{host_name=\"pi-4b-hh\"}[$__rate_interval])))",
          "legendFormat": "cpu"
        },
        {
          "refId": "B",
          "expr": "100 * sum(system_memory_usage_bytes{host_name=\"pi-4b-hh\",state=\"used\"}) / sum(system_memory_usage_bytes{host_name=\"pi-4b-hh\"})",
