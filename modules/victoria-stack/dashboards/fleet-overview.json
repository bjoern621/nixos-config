          "legendFormat": "disk /"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "pi-4b-hh",
      "description": "Backup target and observability replica. Disk is the root filesystem only, backup drive excluded.",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - sum(rate(system_cpu_time_seconds_total{host_name=\"pi-4b-hh\",state=\"idle\"}[$__rate_interval])) / sum(rate(system_cpu_time_seconds_total{host_name=\"pi-4b-hh\"}[$__rate_interval])))",
          "legendFormat": "cpu"
        },
        {
          "refId": "B",
          "expr": "100 * sum(system_memory_usage_bytes{host_name=\"pi-4b-hh\",state=\"used\"}) / sum(system_memory_usage_bytes{host_name=\"pi-4b-hh\"})",
          "legendFormat": "mem"
        },
        {
          "refId": "C",
          "expr": "100 * sum(system_filesystem_usage_bytes{host_name=\"pi-4b-hh\",mountpoint=\"/\",state=\"used\"}) / sum(system_filesystem_usage_bytes{host_name=\"pi-4b-hh\",mountpoint=\"/\"})",
          "legendFormat": "disk /"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Nodes ready",
      "description": "Kubernetes Ready per cluster node. Standalone machines have no Ready condition; their liveness is Telemetry freshness.",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 6 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "NotReady", "color": "red" },
                "1": { "text": "Ready", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        { "refId": "A", "expr": "min by (k8s_node_name) (k8s_node_condition_ready)", "legendFormat": "{{k8s_node_name}}" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Pods not running",
      "description": "Any phase other than Running. Completed Job pods count until cleanup, so a brief nonzero after a Job is normal.",
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 6 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        { "refId": "A", "expr": "sum(k8s_pod_phase != bool 2)", "legendFormat": "not running" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Container restarts (1h)",
      "description": "Crashes and OOM kills relaunched in place; rollouts do not count. Climbing steadily is a crash loop.",
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 6 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        { "refId": "A", "expr": "sum(increase(k8s_container_restarts[1h]))", "legendFormat": "restarts" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Top pods CPU (cores)",
      "description": "Top eight only, so the lines do not sum to node usage.",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 6 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk_avg(8, sum by (k8s_namespace_name, k8s_pod_name) (k8s_pod_cpu_usage))",
          "legendFormat": "{{k8s_namespace_name}}/{{k8s_pod_name}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Top pods memory (working set)",
      "description": "Working set is what the OOM killer weighs against the limit.",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 6 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk_avg(8, max by (k8s_namespace_name, k8s_pod_name) (k8s_pod_memory_working_set_bytes))",
          "legendFormat": "{{k8s_namespace_name}}/{{k8s_pod_name}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Edge requests by status class",
      "description": "Both edges, all hostnames. A 4xx surge is usually scanners.",
      "gridPos": { "h": 6, "w": 10, "x": 0, "y": 12 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 15, "showPoints": "never" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "2xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "3xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "4xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "5xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (class) (label_replace(rate(traefik_service_requests_total{code=~\"[0-9]{3}\"}[$__rate_interval]), \"class\", \"${1}xx\", \"code\", \"([0-9])..\"))",
          "legendFormat": "{{class}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Edge latency",
      "description": "All services combined. A backend on the other node adds a tailnet round trip; long-polling endpoints inflate the p95.",
      "gridPos": { "h": 6, "w": 8, "x": 10, "y": 12 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traefik_service_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(traefik_service_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "5xx rate",
      "description": "Sustained nonzero means a backend is failing; Recent error logs usually names it.",
      "gridPos": { "h": 6, "w": 3, "x": 18, "y": 12 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.05 },
              { "color": "red", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traefik_service_requests_total{code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "TLS cert expiry",
      "description": "Soonest-expiring edge certificate. Renewal runs about 30 days out, so below three weeks means renewals are failing.",
      "gridPos": { "h": 6, "w": 3, "x": 21, "y": 12 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 7 },
              { "color": "green", "value": 21 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(min(traefik_tls_certs_not_after) - time()) / 86400",
          "legendFormat": "min days left"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Error logs",
      "description": "ERROR and above from all sources: pod logs, host journals, Kubernetes events.",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 18 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "severity_number:>=17", "queryType": "hits" }
      ]
    },
    {
      "id": 14,
      "type": "logs",
      "title": "Recent error logs",
      "description": "Expanding a line shows its fields; k8s.pod.name or unit plus host.name locate the emitter.",
      "gridPos": { "h": 7, "w": 16, "x": 8, "y": 18 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        { "refId": "A", "expr": "severity_number:>=17", "queryType": "instant", "maxLines": 100 }
      ]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Telemetry freshness",
      "description": "Age of each machine's newest sample; normal is under a minute. Climbing means the machine or its push path is down and its other panels are stale, not current.",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 25 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 120 },
              { "color": "red", "value": 600 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(tlast_over_time(system_memory_usage_bytes{k8s_node_name=\"vmk3s\"}[6h]))",
          "legendFormat": "vmk3s"
        },
        {
          "refId": "D",
          "expr": "time() - max(tlast_over_time(system_memory_usage_bytes{k8s_node_name=\"netcup-g12\"}[6h]))",
          "legendFormat": "netcup-g12"
        },
        {
          "refId": "B",
          "expr": "time() - max(tlast_over_time(system_memory_usage_bytes{host_name=\"homelab\"}[6h]))",
          "legendFormat": "homelab"
        },
        {
          "refId": "C",
          "expr": "time() - max(tlast_over_time(system_memory_usage_bytes{host_name=\"pi-4b-hh\"}[6h]))",
          "legendFormat": "pi-4b-hh"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Collector export failures",
      "description": "Telemetry dropped after retries: real gaps in the stores, not a display problem.",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 25 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(otelcol_exporter_send_failed_metric_points_total[$__rate_interval]))",
          "legendFormat": "metric points"
        },
        {
          "refId": "B",
