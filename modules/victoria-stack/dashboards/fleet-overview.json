{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "vmk3s",
      "description": "The k3s server VM. Disk is the root filesystem only.",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - sum(rate(system_cpu_time_seconds_total{k8s_node_name=\"vmk3s\",state=\"idle\"}[$__rate_interval])) / sum(rate(system_cpu_time_seconds_total{k8s_node_name=\"vmk3s\"}[$__rate_interval])))",
          "legendFormat": "cpu"
        },
        {
          "refId": "B",
          "expr": "100 * sum(system_memory_usage_bytes{k8s_node_name=\"vmk3s\",state=\"used\"}) / sum(system_memory_usage_bytes{k8s_node_name=\"vmk3s\"})",
          "legendFormat": "mem"
        },
        {
          "refId": "C",
          "expr": "100 * sum(system_filesystem_usage_bytes{k8s_node_name=\"vmk3s\",mountpoint=\"/\",state=\"used\"}) / sum(system_filesystem_usage_bytes{k8s_node_name=\"vmk3s\",mountpoint=\"/\"})",
          "legendFormat": "disk /"
        }
      ]
    },
    {
      "id": 20,
      "type": "stat",
      "title": "netcup-g12",
      "description": "The netcup VPS, k3s agent node. Disk is the root filesystem only.",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - sum(rate(system_cpu_time_seconds_total{k8s_node_name=\"netcup-g12\",state=\"idle\"}[$__rate_interval])) / sum(rate(system_cpu_time_seconds_total{k8s_node_name=\"netcup-g12\"}[$__rate_interval])))",
          "legendFormat": "cpu"
        },
        {
          "refId": "B",
          "expr": "100 * sum(system_memory_usage_bytes{k8s_node_name=\"netcup-g12\",state=\"used\"}) / sum(system_memory_usage_bytes{k8s_node_name=\"netcup-g12\"})",
          "legendFormat": "mem"
        },
        {
          "refId": "C",
          "expr": "100 * sum(system_filesystem_usage_bytes{k8s_node_name=\"netcup-g12\",mountpoint=\"/\",state=\"used\"}) / sum(system_filesystem_usage_bytes{k8s_node_name=\"netcup-g12\",mountpoint=\"/\"})",
          "legendFormat": "disk /"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "homelab",
      "description": "Standalone server. Disk is the root filesystem only, data drives excluded.",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - sum(rate(system_cpu_time_seconds_total{host_name=\"homelab\",state=\"idle\"}[$__rate_interval])) / sum(rate(system_cpu_time_seconds_total{host_name=\"homelab\"}[$__rate_interval])))",
          "legendFormat": "cpu"
        },
        {
          "refId": "B",
          "expr": "100 * sum(system_memory_usage_bytes{host_name=\"homelab\",state=\"used\"}) / sum(system_memory_usage_bytes{host_name=\"homelab\"})",
