          "legendFormat": "disk /"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Nodes ready",
      "description": "The Kubernetes Ready condition of each cluster node, read from the API server. NotReady means the kubelet stopped reporting; the node's pods are rescheduled only where taints and their storage allow. Covers cluster nodes only. Standalone machines have no Ready condition; their liveness is the Telemetry freshness panel.",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 6 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "NotReady", "color": "red" },
                "1": { "text": "Ready", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        { "refId": "A", "expr": "min by (k8s_node_name) (k8s_node_condition_ready)", "legendFormat": "{{k8s_node_name}}" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Pods not running",
      "description": "Pods in any phase other than Running: Pending, Succeeded, Failed, or Unknown, across all namespaces. A completed Job pod counts until it is cleaned up, so a short-lived nonzero after a Job is normal. A value that stays up without Jobs around usually means a pod stuck Pending on scheduling or storage.",
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 6 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        { "refId": "A", "expr": "sum(k8s_pod_phase != bool 2)", "legendFormat": "not running" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Container restarts (1h)",
      "description": "Container restarts across the cluster in the last hour. A restart means a container exited or was OOM-killed and the kubelet relaunched it in place. Rollouts create new pods and do not count. A steadily climbing value is a crash loop; the Recent error logs panel usually names the pod.",
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 6 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        { "refId": "A", "expr": "sum(increase(k8s_container_restarts[1h]))", "legendFormat": "restarts" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Top pods CPU (cores)",
      "description": "The eight pods with the highest average CPU over the window, in cores, kubelet-reported, all namespaces. Pods below the top eight are not drawn, so the lines do not sum to node usage.",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 6 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk_avg(8, sum by (k8s_namespace_name, k8s_pod_name) (k8s_pod_cpu_usage))",
          "legendFormat": "{{k8s_namespace_name}}/{{k8s_pod_name}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Top pods memory (working set)",
      "description": "The eight pods with the highest working-set memory. Working set is the number the OOM killer weighs against the limit, so a line approaching its pod's memory limit predicts an OOM kill.",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 6 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk_avg(8, max by (k8s_namespace_name, k8s_pod_name) (k8s_pod_memory_working_set_bytes))",
          "legendFormat": "{{k8s_namespace_name}}/{{k8s_pod_name}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Edge requests by status class",
      "description": "HTTP requests per second through the Traefik edge proxies, both nodes and all hostnames combined, grouped by status class. A 4xx surge is usually scanners or a broken client; 5xx belongs to the 5xx rate panel.",
      "gridPos": { "h": 6, "w": 10, "x": 0, "y": 12 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 15, "showPoints": "never" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "2xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "3xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "4xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "5xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (class) (label_replace(rate(traefik_service_requests_total{code=~\"[0-9]{3}\"}[$__rate_interval]), \"class\", \"${1}xx\", \"code\", \"([0-9])..\"))",
          "legendFormat": "{{class}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Edge latency",
      "description": "Request duration through the Traefik edges, p50 and p95 over all services combined. A request that arrives at one edge for a backend on the other node crosses the tailnet and pays that round trip (docs/edges.md). Long-polling and streaming endpoints inflate the p95 without anything being wrong.",
      "gridPos": { "h": 6, "w": 8, "x": 10, "y": 12 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traefik_service_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(traefik_service_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "5xx rate",
      "description": "Server-error responses per second across both edges. Sustained nonzero means a backend is failing or unreachable; the Recent error logs panel usually names it. Client mistakes land in 4xx, not here.",
      "gridPos": { "h": 6, "w": 3, "x": 18, "y": 12 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.05 },
              { "color": "red", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traefik_service_requests_total{code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "TLS cert expiry",
      "description": "Days until the soonest-expiring certificate loaded by the edge proxies. cert-manager renews about 30 days before expiry, so this normally never drops below three weeks. Orange or red means renewals are failing: check the certificate resources and the ACME solver path (docs/edges.md).",
      "gridPos": { "h": 6, "w": 3, "x": 21, "y": 12 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 7 },
              { "color": "green", "value": 21 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(min(traefik_tls_certs_not_after) - time()) / 86400",
          "legendFormat": "min days left"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Error logs",
      "description": "Log records of severity ERROR or above per interval, from every source the collectors ship: pod logs, host journals of all machines, and Kubernetes events. A flat elevated band is one component erroring steadily; the Recent error logs panel shows which.",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 18 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "severity_number:>=17", "queryType": "hits" }
      ]
    },
    {
      "id": 14,
      "type": "logs",
      "title": "Recent error logs",
      "description": "The newest log records of severity ERROR or above, all sources. Expanding a line shows its fields; k8s.pod.name or unit plus host.name locate the emitter. Severity comes from the source's own labeling, so a chatty component can rank a harmless condition as an error.",
      "gridPos": { "h": 7, "w": 16, "x": 8, "y": 18 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        { "refId": "A", "expr": "severity_number:>=17", "queryType": "instant", "maxLines": 100 }
      ]
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Telemetry freshness",
      "description": "Seconds since each machine's newest host-metric sample reached the metrics store: the monitoring system's own heartbeat. Green means every other panel on this dashboard shows live data for that machine. A climbing value means the machine, its collector, or the push path to the store is down, and the machine's other panels are frozen at the last data that got through, not showing the present. Normal is under a minute (one collection interval).",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 25 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 120 },
              { "color": "red", "value": 600 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(tlast_over_time(system_memory_usage_bytes{k8s_node_name=\"vmk3s\"}[6h]))",
          "legendFormat": "vmk3s"
        },
        {
          "refId": "D",
