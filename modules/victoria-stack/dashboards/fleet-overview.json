    {
      "id": 16,
      "type": "timeseries",
      "title": "Collector export failures",
      "description": "Metric points, log records, and spans a collector tried to deliver and gave up on after retries. Anything above zero is telemetry lost for good: gaps in these panels, not a display problem. Usual causes are a store out of disk or an unreachable push target; the collector's own logs name the exporter.",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 25 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 8, "showPoints": "never" }
