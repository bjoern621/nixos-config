          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Queued above zero means every thread is busy and requests are waiting on a worker. worker_processes is the dial."
