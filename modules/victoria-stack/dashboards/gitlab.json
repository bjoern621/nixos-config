      "targets": [
        {
          "refId": "A",
          "expr": "sum(puma_pool_capacity)",
          "legendFormat": "capacity"
        },
        {
          "refId": "B",
          "expr": "sum(puma_active_connections)",
          "legendFormat": "active"
        },
        {
          "refId": "C",
          "expr": "sum(puma_queued_connections)",
          "legendFormat": "queued"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
