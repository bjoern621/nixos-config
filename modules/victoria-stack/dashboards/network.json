  "preload": null,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Paths and delay",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Reachability",
      "description": "Every probe target, as last seen from each cluster node. A path the tailnet policy does not grant reads as down.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tcpcheck_status_ratio",
          "legendFormat": "{{k8s_node_name}} {{probe_protocol}} {{tcpcheck_endpoint}}"
        },
        {
          "refId": "B",
          "expr": "sum by (k8s_node_name, http_url) (httpcheck_status{http_status_class=~\"2xx|3xx\"})",
          "legendFormat": "{{k8s_node_name}} {{http_url}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "index": 0
                },
                "1": {
                  "text": "up",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Round-trip time and loss",
      "description": "Solid lines are echo round-trip on the left axis. Dashed lines are packet loss on the right.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ping_rtt_avg_milliseconds",
          "legendFormat": "{{k8s_node_name}} to {{net_peer_name}}"
        },
        {
          "refId": "B",
          "expr": "ping_loss_ratio_percent",
          "legendFormat": "loss {{k8s_node_name}} to {{net_peer_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "loss .*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.axisLabel",
                "value": "packet loss"
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Connect time by protocol",
      "description": "TCP handshake alone, grouped by the service behind the port. It shows the path cost without any backend work.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (k8s_node_name, probe_protocol) (tcpcheck_duration_milliseconds)",
          "legendFormat": "{{k8s_node_name}} {{probe_protocol}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP response time",
      "description": "Full request against each public name, so it carries DNS, TLS and the backend.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "expr": "httpcheck_duration_milliseconds",
          "legendFormat": "{{k8s_node_name}} to {{http_url}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Where HTTP time goes",
      "description": "Averaged over every probed endpoint and both nodes. Use it to tell a slow name lookup from a slow backend.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(httpcheck_dns_lookup_duration_nanoseconds)",
          "legendFormat": "dns"
        },
        {
          "refId": "B",
          "expr": "avg(httpcheck_client_connection_duration_nanoseconds)",
          "legendFormat": "connect"
        },
        {
          "refId": "C",
          "expr": "avg(httpcheck_tls_handshake_duration_nanoseconds)",
          "legendFormat": "tls handshake"
        },
        {
          "refId": "D",
          "expr": "avg(httpcheck_client_request_duration_nanoseconds)",
          "legendFormat": "request"
        },
        {
          "refId": "E",
          "expr": "avg(httpcheck_response_duration_nanoseconds)",
          "legendFormat": "response"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ns",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Traffic",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Throughput",
      "description": "One line per interface and direction. Narrow it with the Interface picker: a physical name is the uplink, tailscale0 is the path between sites, cni0 and flannel.1 are pod traffic.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (k8s_node_name, host_name, device, direction) (rate(system_network_io_bytes_total{device=~\"$device\"}[$__rate_interval]))",
          "legendFormat": "{{k8s_node_name}}{{host_name}} {{device}} {{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "binBps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Errors and drops",
      "description": "Anything above zero here explains stalls and retransmits elsewhere on this page.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (k8s_node_name, host_name, direction) (rate(system_network_errors_total[$__rate_interval]))",
          "legendFormat": "{{k8s_node_name}}{{host_name}} {{direction}} errors"
        },
        {
          "refId": "B",
          "expr": "sum by (k8s_node_name, host_name, direction) (rate(system_network_dropped_total[$__rate_interval]))",
          "legendFormat": "{{k8s_node_name}}{{host_name}} {{direction}} drops"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "TCP connections by state",
      "description": "Sockets on the node. A climbing TIME_WAIT count points at short-lived connections.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (k8s_node_name, host_name, state) (system_network_connections{state=~\"ESTABLISHED|TIME_WAIT|LISTEN|SYN_SENT|CLOSE_WAIT\"})",
          "legendFormat": "{{k8s_node_name}}{{host_name}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Busiest pods",
      "description": "Ten pods moving the most bytes. The workload names the protocol its traffic carries.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (k8s_namespace_name, k8s_pod_name) (rate(k8s_pod_network_io_bytes_total[$__rate_interval])))",
          "legendFormat": "{{k8s_namespace_name}}/{{k8s_pod_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "binBps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Edge",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 49
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Requests and errors",
      "description": "Counted at Traefik, per node and entrypoint. web is plain HTTP on port 80, websecure is TLS on 443.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 50
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node, entrypoint) (rate(traefik_entrypoint_requests_total{entrypoint=~\"web|websecure\"}[$__rate_interval]))",
          "legendFormat": "{{node}} {{entrypoint}}"
        },
        {
          "refId": "B",
          "expr": "sum by (node, code) (rate(traefik_entrypoint_requests_total{entrypoint=~\"web|websecure\",code=~\"[45]..\"}[$__rate_interval]))",
          "legendFormat": "{{node}} {{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Edge latency, 95th percentile",
      "description": "Time Traefik spent on a request, backend included.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 50
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, node, entrypoint) (rate(traefik_entrypoint_request_duration_seconds_bucket{entrypoint=~\"web|websecure\"}[$__rate_interval])))",
          "legendFormat": "{{node}} {{entrypoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
