    {
      "type": "timeseries",
      "title": "Round-trip time and loss",
      "description": "Solid lines show echo round trip on the left axis, dashed lines packet loss on the right.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "ping_rtt_avg_milliseconds{k8s_node_name=~\"$node\"}",
          "legendFormat": "{{k8s_node_name}} to {{net_peer_name}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "ping_loss_ratio_percent{k8s_node_name=~\"$node\"}",
          "legendFormat": "loss {{k8s_node_name}} to {{net_peer_name}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": 120000,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "links": [
            {
              "title": "Host detail for ${__field.labels.k8s_node_name}",
              "url": "/d/host?var-host=${__field.labels.k8s_node_name}&${__url_time_range}&${syncs:queryparam}&${rebuilds:queryparam}",
              "targetBlank": false
            }
          ],
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "loss .*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
