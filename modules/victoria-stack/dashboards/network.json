    {
      "type": "stat",
      "title": "",
      "description": "Probe targets that at least one node did not reach on its last try. A port that the tailnet policy does not grant reads as unreachable.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "count(max by (k8s_node_name, target) (label_join(max by (k8s_node_name, probe_protocol, tcpcheck_endpoint) (last_over_time(tcpcheck_status_ratio{k8s_node_name=~\"$node\"}[5m])), \"target\", \" \", \"probe_protocol\", \"tcpcheck_endpoint\") or label_copy(max by (k8s_node_name, http_url) (max_over_time(sum by (k8s_node_name, http_url) (httpcheck_status{k8s_node_name=~\"$node\",http_status_class=~\"2xx|3xx\"})[5m:])), \"http_url\", \"target\")) == 0) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "displayName": "Unreachable"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "",
