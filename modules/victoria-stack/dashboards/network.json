  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Argo CD syncs",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "enable": true,
        "hide": true,
        "iconColor": "purple",
        "expr": "(sum by (name, phase) (increase(argocd_app_sync_total{dry_run=\"false\",name!~\".+-mr-[0-9]+\"}[2m])) > 0 unless on (name) sum by (name) (increase(argocd_app_sync_total{dry_run=\"false\"}[1h])) > 6) and on () vector($syncs) > 0",
        "step": "2m",
        "titleFormat": "Sync {{name}}",
        "textFormat": "{{phase}}",
        "useValueForTime": false
      },
      {
        "name": "Host rebuilds",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "enable": true,
        "hide": true,
        "iconColor": "orange",
        "expr": "(max by (host_name, revision) (sysconf_installed_commit_time_seconds) unless max by (host_name, revision) (sysconf_installed_commit_time_seconds offset 15m)) and on () vector($rebuilds) > 0",
        "step": "5m",
        "titleFormat": "Rebuild {{host_name}}",
        "textFormat": "{{revision}}",
        "useValueForTime": false
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Probing node",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "query": "label_values(tcpcheck_status_ratio, k8s_node_name)",
        "definition": "label_values(tcpcheck_status_ratio, k8s_node_name)",
        "regex": "",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "description": "Cluster nodes whose probes and interfaces to show.",
        "hide": 0,
        "options": [],
        "allValue": ".*"
      },
      {
        "name": "device",
        "label": "Interface",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "query": "label_values(system_network_io_bytes_total{device!~\"lo|veth.*|lxc.*|cali.*\"}, device)",
        "definition": "label_values(system_network_io_bytes_total{device!~\"lo|veth.*|lxc.*|cali.*\"}, device)",
        "regex": "",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "description": "A physical name carries the uplink, tailscale0 the path between sites, cilium devices the pod traffic.",
        "hide": 0,
        "options": [],
        "allValue": ".*"
      },
      {
        "name": "syncs",
        "label": "Argo CD syncs",
        "type": "custom",
        "query": "shown : 1,hidden : 0",
        "multi": false,
        "includeAll": false,
        "description": "Marks each Argo CD sync on the time series.",
        "hide": 0,
