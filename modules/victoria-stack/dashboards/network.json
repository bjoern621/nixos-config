    {
      "type": "table",
      "title": "Reachability",
      "description": "Every probe target as last seen from each node, one column per node.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "max by (k8s_node_name, target) (label_join(max by (k8s_node_name, probe_protocol, tcpcheck_endpoint) (last_over_time(tcpcheck_status_ratio{k8s_node_name=~\"$node\"}[5m])), \"target\", \" \", \"probe_protocol\", \"tcpcheck_endpoint\") or label_copy(max by (k8s_node_name, http_url) (max_over_time(sum by (k8s_node_name, http_url) (httpcheck_status{k8s_node_name=~\"$node\",http_status_class=~\"2xx|3xx\"})[5m:])), \"http_url\", \"target\"))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(?!Target$).*"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "unreachable",
                        "color": "red"
                      },
                      "1": {
                        "text": "reached",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Target"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 300
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": "",
          "countRows": false
        },
        "sortBy": [
          {
            "displayName": "Target",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "k8s_node_name",
            "rowField": "target",
            "valueField": "Value",
            "emptyValue": "null"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": {
              "target\\k8s_node_name": "Target"
            }
          }
        }
      ],
