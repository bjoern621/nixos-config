{
  "uid": "network",
  "title": "Network",
  "description": "Whether the probes on every cluster node reach each target, how long the paths take, and what the hosts move over their interfaces. Every node probes the same targets, so one target slow from one node and fast from the other points at the path.",
  "tags": [
    "hh",
    "network",
    "probes"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "refresh": "1m",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
