              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "drop.reason"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Reason"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "drop.policy"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Denied by"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "source.namespace"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "destination.namespace"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "drops"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Drops"
              },
              {
