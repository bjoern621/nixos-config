{
  "uid": "cluster-network",
  "title": "Network / In-cluster traffic",
  "description": "Which traffic Cilium drops, and whether cluster DNS answers. Policy verdicts come from Hubble's counters, the single drops from the drop log, DNS from CoreDNS.",
  "tags": [
    "hh",
    "network",
    "kubernetes",
    "cilium"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "refresh": "1m",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "links": [
    {
      "title": "Fleet overview",
      "type": "link",
      "url": "/d/fleet-overview?${syncs:queryparam}&${rebuilds:queryparam}",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "asDropdown": false,
      "targetBlank": false,
      "tags": [],
      "tooltip": "Start page: every host, service and signal at a glance"
    },
    {
      "title": "Dashboards",
      "type": "dashboards",
      "tags": [
        "hh"
      ],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    },
    {
      "title": "Gateway requests",
      "type": "link",
      "url": "/d/edge?${syncs:queryparam}&${rebuilds:queryparam}",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "asDropdown": false,
      "targetBlank": false,
      "tags": [],
      "tooltip": "Requests through the Gateways, with their callers"
    },
    {
      "title": "Kubernetes workloads",
      "type": "link",
      "url": "/d/k8s?${syncs:queryparam}&${rebuilds:queryparam}",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "asDropdown": false,
      "targetBlank": false,
      "tags": [],
      "tooltip": "Pods, resources, events and logs"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Argo CD syncs",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "enable": true,
        "hide": true,
        "iconColor": "purple",
        "expr": "(sum by (name, phase) (increase(argocd_app_sync_total{dry_run=\"false\",name!~\".+-mr-[0-9]+\"}[2m])) > 0 unless on (name) sum by (name) (increase(argocd_app_sync_total{dry_run=\"false\"}[1h])) > 6) and on () vector($syncs) > 0",
        "step": "2m",
        "titleFormat": "Sync {{name}}",
        "textFormat": "{{phase}}",
        "useValueForTime": false
      },
      {
        "name": "Host rebuilds",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "enable": true,
        "hide": true,
        "iconColor": "orange",
        "expr": "(max by (host_name, revision) (sysconf_installed_commit_time_seconds) unless max by (host_name, revision) (sysconf_installed_commit_time_seconds offset 15m)) and on () vector($rebuilds) > 0",
        "step": "5m",
        "titleFormat": "Rebuild {{host_name}}",
        "textFormat": "{{revision}}",
        "useValueForTime": false
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "query": "label_values(hubble_policy_verdicts_total, node)",
        "definition": "label_values(hubble_policy_verdicts_total, node)",
        "regex": "",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "description": "Node whose Cilium agent saw the packet.",
        "hide": 0,
        "options": [],
        "allValue": ".*"
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "query": "label_values(k8s_pod_cpu_usage, k8s_namespace_name)",
        "definition": "label_values(k8s_pod_cpu_usage, k8s_namespace_name)",
        "regex": "",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "description": "Namespace of the pod on either side of a dropped packet.",
        "hide": 0,
        "options": [],
        "allValue": ".*"
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [
          {
            "selected": true,
            "text": "",
            "value": ""
          }
        ],
        "description": "Text the drop lines must contain, for example an address or a port. Empty shows every drop.",
        "hide": 0
      },
      {
        "name": "syncs",
        "label": "Argo CD syncs",
        "type": "custom",
        "query": "shown : 1,hidden : 0",
        "multi": false,
        "includeAll": false,
        "description": "Marks each Argo CD sync on the time series.",
        "hide": 0,
        "current": {
          "selected": true,
          "text": "shown",
          "value": "1"
        },
        "options": [
          {
            "selected": true,
            "text": "shown",
            "value": "1"
          },
          {
            "selected": false,
            "text": "hidden",
            "value": "0"
          }
        ]
      },
      {
        "name": "rebuilds",
        "label": "Host rebuilds",
        "type": "custom",
        "query": "shown : 1,hidden : 0",
        "multi": false,
        "includeAll": false,
        "description": "Marks each NixOS rebuild on the time series.",
        "hide": 0,
        "current": {
          "selected": true,
          "text": "shown",
          "value": "1"
        },
        "options": [
          {
            "selected": true,
            "text": "shown",
            "value": "1"
          },
          {
            "selected": false,
            "text": "hidden",
            "value": "0"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Verdicts",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "",
      "description": "Packets that policy dropped over the selected range, from Hubble's counters.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "sum(increase(hubble_policy_verdicts_total{action=\"dropped\",node=~\"$node\"}[$__range])) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "displayName": "Dropped"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "",
      "description": "Share of policy verdicts that dropped the packet.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "100 * sum(rate(hubble_policy_verdicts_total{action=\"dropped\",node=~\"$node\"}[$__range])) / sum(rate(hubble_policy_verdicts_total{node=~\"$node\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "displayName": "Drop share"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "",
      "description": "Dropped packets in the drop log for the selection, every reason included.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "_stream:{service.name=\"hubble\"} drop.reason:* k8s.node.name:in($node) (source.namespace:in($namespace) or destination.namespace:in($namespace)) _msg:~\"$search\" | stats count() drops",
          "queryType": "stats",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "displayName": "Drops logged"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "",
      "description": "Share of DNS answers with SERVFAIL or REFUSED. NXDOMAIN counts as an answer: search domains produce it on every lookup.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "100 * sum(rate(coredns_dns_responses_total{job=\"coredns\",k8s_node_name=~\"$node\",rcode=~\"SERVFAIL|REFUSED\"}[$__range])) / sum(rate(coredns_dns_responses_total{job=\"coredns\",k8s_node_name=~\"$node\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "displayName": "DNS failures"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "",
      "description": "95th percentile time CoreDNS took to answer.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(coredns_dns_request_duration_seconds_bucket{job=\"coredns\",k8s_node_name=~\"$node\"}[$__range])))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "displayName": "DNS p95"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 6
    },
    {
      "type": "stat",
      "title": "",
      "description": "Flows Hubble could not keep or export over the selected range. Lost flows leave holes in the drop and request logs.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "sum(increase(hubble_lost_events_total{node=~\"$node\"}[$__range])) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "displayName": "Flows lost"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "id": 7
    },
    {
      "type": "table",
      "title": "Who gets dropped",
      "description": "Dropped packets grouped by source, destination, port and reason, most frequent first. A pod appears as <namespace>/<workload>, an address outside the cluster as world. Select a side to open its workloads.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "_stream:{service.name=\"hubble\"} drop.reason:* k8s.node.name:in($node) (source.namespace:in($namespace) or destination.namespace:in($namespace)) _msg:~\"$search\" | stats by (source.name, destination.name, destination.address, destination.port, destination.domain, network.transport, drop.direction, drop.reason, drop.policy, source.namespace, destination.namespace) count() drops, max(_time) last | math round(last / 1000000) as last | sort by (drops desc) | limit 200",
          "queryType": "stats",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "source.name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Source"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Workloads in ${__data.fields[\"source.namespace\"]}",
                    "url": "/d/k8s?var-namespace=${__data.fields[\"source.namespace\"]}&${__url_time_range}&${syncs:queryparam}&${rebuilds:queryparam}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "destination.name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Destination"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Workloads in ${__data.fields[\"destination.namespace\"]}",
                    "url": "/d/k8s?var-namespace=${__data.fields[\"destination.namespace\"]}&${__url_time_range}&${syncs:queryparam}&${rebuilds:queryparam}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "destination.address"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Address"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Connections from ${__data.fields[\"destination.address\"]}",
                    "url": "/d/network-flows?var-ip=${__data.fields[\"destination.address\"]}&${__url_time_range}&${syncs:queryparam}&${rebuilds:queryparam}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "destination.port"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Port"
              },
              {
                "id": "custom.width",
                "value": 70
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "destination.domain"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Domain"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "network.transport"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Protocol"
              },
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "drop.direction"
