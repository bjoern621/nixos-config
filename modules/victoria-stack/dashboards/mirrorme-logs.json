                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "k8s.container.name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Container"
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "_msg"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Message"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "lines"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Lines"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "last"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Last seen"
              },
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              },
              {
