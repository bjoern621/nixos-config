{
  "uid": "mirrorme-logs",
  "title": "Services / MirrorMe logs",
  "description": "Every log line that the screenshare pod writes, by container, with the warnings and errors, report intake and the pod's Kubernetes events beside them. Search narrows every line panel. MirrorMe carries the metrics.",
  "tags": [
    "hh",
    "mirrorme",
    "screenshare",
    "logs"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "refresh": "1m",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "links": [
    {
      "title": "Fleet overview",
      "type": "link",
      "url": "/d/fleet-overview?${syncs:queryparam}&${rebuilds:queryparam}",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "asDropdown": false,
      "targetBlank": false,
      "tags": [],
      "tooltip": "Start page: every host, service and signal at a glance"
    },
    {
      "title": "Dashboards",
      "type": "dashboards",
      "tags": [
        "hh"
      ],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    },
    {
      "title": "Pods of screenshare",
      "type": "link",
      "url": "/d/k8s?var-namespace=screenshare&${syncs:queryparam}&${rebuilds:queryparam}",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "asDropdown": false,
      "targetBlank": false,
      "tags": [],
      "tooltip": "Resources, restarts and logs"
    },
    {
      "title": "Gateway requests to screenshare",
      "type": "link",
      "url": "/d/edge?var-svc=screenshare/screenshare&${syncs:queryparam}&${rebuilds:queryparam}",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "asDropdown": false,
      "targetBlank": false,
      "tags": [],
      "tooltip": "Requests through the Gateways, with their clients"
    },
    {
      "title": "MirrorMe",
      "type": "link",
      "url": "/d/relay-groups?${syncs:queryparam}&${rebuilds:queryparam}",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "asDropdown": false,
      "targetBlank": false,
      "tags": [],
      "tooltip": "Streams, groups and enforcement"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Argo CD syncs",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "enable": true,
        "hide": true,
        "iconColor": "purple",
        "expr": "(sum by (name, phase) (increase(argocd_app_sync_total{dry_run=\"false\",name!~\".+-mr-[0-9]+\"}[2m])) > 0 unless on (name) sum by (name) (increase(argocd_app_sync_total{dry_run=\"false\"}[1h])) > 6) and on () vector($syncs) > 0",
        "step": "2m",
        "titleFormat": "Sync {{name}}",
        "textFormat": "{{phase}}",
        "useValueForTime": false
      },
      {
        "name": "Host rebuilds",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "enable": true,
        "hide": true,
        "iconColor": "orange",
        "expr": "(max by (host_name, revision) (sysconf_installed_commit_time_seconds) unless max by (host_name, revision) (sysconf_installed_commit_time_seconds offset 15m)) and on () vector($rebuilds) > 0",
        "step": "5m",
        "titleFormat": "Rebuild {{host_name}}",
        "textFormat": "{{revision}}",
        "useValueForTime": false
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [
          {
            "selected": true,
            "text": "",
            "value": ""
          }
        ],
        "description": "Text that the lines must contain, for example a stream path, a group prefix or a report id. Empty shows every line.",
        "hide": 0
      },
      {
        "name": "syncs",
        "label": "Argo CD syncs",
        "type": "custom",
        "query": "shown : 1,hidden : 0",
        "multi": false,
        "includeAll": false,
        "description": "Marks each Argo CD sync on the time series.",
        "hide": 0,
        "current": {
          "selected": true,
          "text": "shown",
          "value": "1"
        },
        "options": [
          {
            "selected": true,
            "text": "shown",
            "value": "1"
          },
          {
            "selected": false,
            "text": "hidden",
            "value": "0"
          }
        ]
      },
      {
        "name": "rebuilds",
        "label": "Host rebuilds",
        "type": "custom",
        "query": "shown : 1,hidden : 0",
        "multi": false,
        "includeAll": false,
        "description": "Marks each NixOS rebuild on the time series.",
        "hide": 0,
        "current": {
          "selected": true,
          "text": "shown",
          "value": "1"
        },
        "options": [
          {
            "selected": true,
            "text": "shown",
            "value": "1"
          },
          {
            "selected": false,
            "text": "hidden",
            "value": "0"
          }
        ]
      }
    ]
  },
