    {
      "type": "stat",
      "title": "Warnings and errors",
      "description": "Warning and error lines from all four containers over the selected range, Go tracebacks included.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "k8s.namespace.name:=screenshare (\"[ERROR]\" or \"[WARN]\" or \"panic:\" or \"fatal error:\" or \"ERR\" or \"WAR\" or \"\\\"level\\\":\\\"error\\\"\" or \"\\\"level\\\":\\\"warn\\\"\") | stats count() lines",
          "queryType": "stats",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
