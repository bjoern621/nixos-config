    {
      "type": "table",
      "title": "Recurring warnings",
      "description": "Warning and error lines grouped after masking numbers, IDs and addresses, most frequent first.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "k8s.namespace.name:=screenshare (\"[ERROR]\" or \"[WARN]\" or \"panic:\" or \"fatal error:\" or \"ERR\" or \"WAR\" or \"\\\"level\\\":\\\"error\\\"\" or \"\\\"level\\\":\\\"warn\\\"\") | collapse_nums prettify | stats by (k8s.container.name, _msg) count() lines, max(_time) last | math round(last / 1000000) as last | sort by (lines desc) | limit 50",
          "queryType": "stats",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          },
          "thresholds": {
