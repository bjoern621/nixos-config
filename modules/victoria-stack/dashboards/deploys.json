    {
      "type": "table",
      "title": "Applications",
      "description": "Every Argo CD application with its state and its syncs over the selected range. Select an application to narrow the dashboard to it, its namespace to open its workloads.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "max by (name, dest_namespace, sync_status, health_status, autosync_enabled) (argocd_app_info{name=~\"$app\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "sum by (name) (increase(argocd_app_sync_total{name=~\"$app\",dry_run=\"false\"}[$__range]))",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "sum by (name) (increase(argocd_app_sync_total{name=~\"$app\",dry_run=\"false\",phase=~\"Failed|Error\"}[$__range]))",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "1000 * max by (name) (tlast_change_over_time(argocd_app_sync_total{name=~\"$app\",dry_run=\"false\"}[$__range]))",
          "legendFormat": "",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Application"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 220
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Deploys of ${__data.fields[\"Application\"]}",
                    "url": "/d/deploys?var-app=${__data.fields[\"Application\"]}&${__url_time_range}&${syncs:queryparam}&${rebuilds:queryparam}",
                    "targetBlank": false
                  },
                  {
                    "title": "Open in Argo CD",
                    "url": "https://argocd.tailnet.bjoernblessin.de/applications/argocd/${__data.fields[\"Application\"]}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Namespace"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Workloads in ${__data.fields[\"Namespace\"]}",
                    "url": "/d/k8s?var-namespace=${__data.fields[\"Namespace\"]}&${__url_time_range}&${syncs:queryparam}&${rebuilds:queryparam}",
                    "targetBlank": false
                  },
                  {
                    "title": "Dropped traffic of ${__data.fields[\"Namespace\"]}",
                    "url": "/d/cluster-network?var-namespace=${__data.fields[\"Namespace\"]}&${__url_time_range}&${syncs:queryparam}&${rebuilds:queryparam}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Sync"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
