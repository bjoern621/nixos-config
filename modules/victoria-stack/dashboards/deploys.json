                  {
                    "type": "value",
                    "options": {
                      "Synced": {
                        "color": "green"
                      },
                      "OutOfSync": {
                        "color": "orange"
                      },
                      "Unknown": {
                        "color": "red"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Health"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Healthy": {
