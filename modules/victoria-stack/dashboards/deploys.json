              },
              {
                "id": "noValue",
                "value": "before the range"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": "",
          "countRows": false
        },
        "sortBy": [
          {
            "displayName": "Last sync",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "name",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": {
              "name": "Application",
              "dest_namespace": "Namespace",
              "sync_status": "Sync",
              "health_status": "Health",
              "autosync_enabled": "Auto-sync",
              "Value #B": "Syncs",
              "Value #C": "Failed",
              "Value #D": "Last sync"
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(Application|Namespace|Sync|Health|Auto-sync|Syncs|Failed|Last sync)$"
            }
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 11
