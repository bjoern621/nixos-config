    {
      "type": "table",
      "title": "Revisions per host",
      "description": "Each nixos-config revision a host ran within the selected range, newest first. A host takes a new revision on its daily pull or on a manual sysconf-pull.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "1000 * min by (host_name, revision, dirty) (tfirst_over_time(sysconf_installed_commit_time_seconds[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "1000 * max by (host_name, revision, dirty) (last_over_time(sysconf_installed_commit_time_seconds[$__range]))",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
