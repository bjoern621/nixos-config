              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failed"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "noValue",
                "value": "0"
              },
              {
                "id": "custom.cellOptions",
