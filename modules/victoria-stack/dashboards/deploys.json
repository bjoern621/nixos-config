{
  "uid": "deploys",
  "title": "Fleet / Deploys",
  "description": "What changed, and whether it landed. Argo CD syncs every application from git; the hosts rebuild from nixos-config. A step in any other dashboard lines up with the marks drawn here.",
  "tags": [
    "hh",
    "deploys",
    "argocd",
    "gitops"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "refresh": "1m",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "links": [
    {
      "title": "Fleet overview",
      "type": "link",
      "url": "/d/fleet-overview?${syncs:queryparam}&${rebuilds:queryparam}",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "asDropdown": false,
      "targetBlank": false,
      "tags": [],
      "tooltip": "Start page: every host, service and signal at a glance"
    },
    {
      "title": "Dashboards",
      "type": "dashboards",
      "tags": [
        "hh"
      ],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    },
    {
      "title": "Kubernetes workloads",
      "type": "link",
      "url": "/d/k8s?${syncs:queryparam}&${rebuilds:queryparam}",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "asDropdown": false,
      "targetBlank": false,
      "tags": [],
      "tooltip": "Pods, resources, events and logs"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Argo CD syncs",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "enable": true,
        "hide": true,
        "iconColor": "purple",
        "expr": "(sum by (name, phase) (increase(argocd_app_sync_total{dry_run=\"false\",name!~\".+-mr-[0-9]+\"}[2m])) > 0 unless on (name) sum by (name) (increase(argocd_app_sync_total{dry_run=\"false\"}[1h])) > 6) and on () vector($syncs) > 0",
        "step": "2m",
        "titleFormat": "Sync {{name}}",
        "textFormat": "{{phase}}",
        "useValueForTime": false
      },
      {
        "name": "Host rebuilds",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "enable": true,
        "hide": true,
        "iconColor": "orange",
        "expr": "(max by (host_name, revision) (sysconf_installed_commit_time_seconds) unless max by (host_name, revision) (sysconf_installed_commit_time_seconds offset 15m)) and on () vector($rebuilds) > 0",
        "step": "5m",
        "titleFormat": "Rebuild {{host_name}}",
        "textFormat": "{{revision}}",
        "useValueForTime": false
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "query": "label_values(argocd_app_info, name)",
        "definition": "label_values(argocd_app_info, name)",
        "regex": "",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "description": "Argo CD applications to include.",
        "hide": 0,
        "options": [],
        "allValue": ".*"
      },
      {
        "name": "syncs",
        "label": "Argo CD syncs",
        "type": "custom",
        "query": "shown : 1,hidden : 0",
        "multi": false,
        "includeAll": false,
        "description": "Marks each Argo CD sync on the time series.",
        "hide": 0,
        "current": {
          "selected": true,
          "text": "shown",
          "value": "1"
        },
        "options": [
          {
            "selected": true,
            "text": "shown",
            "value": "1"
          },
          {
            "selected": false,
            "text": "hidden",
            "value": "0"
          }
        ]
      },
      {
        "name": "rebuilds",
        "label": "Host rebuilds",
        "type": "custom",
        "query": "shown : 1,hidden : 0",
        "multi": false,
        "includeAll": false,
        "description": "Marks each NixOS rebuild on the time series.",
        "hide": 0,
        "current": {
          "selected": true,
          "text": "shown",
          "value": "1"
        },
        "options": [
          {
            "selected": true,
            "text": "shown",
            "value": "1"
          },
          {
            "selected": false,
            "text": "hidden",
            "value": "0"
          }
        ]
      }
    ]
  },
