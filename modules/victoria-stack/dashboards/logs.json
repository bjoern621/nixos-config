{
  "uid": "logs",
  "title": "Logs explorer",
  "description": "Every log line from host journals and Kubernetes pods. Narrow by source, level and text. Recurring messages are grouped with their numbers masked, so a new kind of failure stands out.",
  "tags": [
    "hh",
    "logs"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "refresh": "1m",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "links": [
    {
      "title": "Fleet overview",
      "type": "link",
      "url": "/d/fleet-overview",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "asDropdown": false,
      "targetBlank": false,
      "tags": [],
      "tooltip": "Start page: every host, service and signal at a glance"
    },
    {
      "title": "Dashboards",
      "type": "dashboards",
      "tags": [
        "hh"
      ],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "error : >=17,warning and up : >=13,info and up : >=9,everything : >=0",
        "multi": false,
        "includeAll": false,
        "description": "Lowest severity to show.",
        "hide": 0,
        "current": {
          "selected": true,
          "text": "info and up",
          "value": ">=9"
        },
        "options": [
          {
            "selected": false,
            "text": "error",
            "value": ">=17"
          },
          {
            "selected": false,
            "text": "warning and up",
            "value": ">=13"
          },
          {
            "selected": true,
            "text": "info and up",
            "value": ">=9"
          },
          {
            "selected": false,
            "text": "everything",
            "value": ">=0"
          }
        ]
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "victorialogs"
        },
        "query": {
          "type": "fieldValue",
          "field": "host.name",
          "query": "host.name:*",
          "limit": 200,
          "refId": "VariableQuery"
        },
        "definition": "host.name where host.name:*",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "description": "Hosts whose journal to show.",
        "hide": 0,
        "regex": "",
        "options": [],
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "unit",
        "label": "Unit",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "victorialogs"
        },
        "query": {
          "type": "fieldValue",
          "field": "unit",
          "query": "host.name:$host",
          "limit": 200,
          "refId": "VariableQuery"
        },
        "definition": "unit where host.name:$host",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "description": "systemd units within those journals.",
        "hide": 0,
        "regex": "",
        "options": [],
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "victorialogs"
        },
        "query": {
          "type": "fieldValue",
          "field": "k8s.namespace.name",
          "query": "k8s.namespace.name:*",
          "limit": 200,
          "refId": "VariableQuery"
        },
        "definition": "k8s.namespace.name where k8s.namespace.name:*",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "description": "Kubernetes namespaces whose pod logs to show.",
        "hide": 0,
        "regex": "",
        "options": [],
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "victorialogs"
        },
        "query": {
          "type": "fieldValue",
          "field": "k8s.pod.name",
          "query": "k8s.namespace.name:$namespace",
          "limit": 200,
          "refId": "VariableQuery"
        },
        "definition": "k8s.pod.name where k8s.namespace.name:$namespace",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "description": "Pods within those namespaces.",
        "hide": 0,
        "regex": "",
        "options": [],
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [
          {
            "selected": true,
            "text": "",
            "value": ""
          }
        ],
        "description": "Regular expression the line must match. Empty shows every line.",
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Volume",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Pod log lines by level",
      "description": "Pod log lines per interval by level, for the selected namespaces and pods.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "k8s.namespace.name:$namespace k8s.pod.name:$pod severity_number:$level _msg:~\"$search\" | stats by (severity_text) count() lines",
          "queryType": "statsRange",
          "refId": "A",
          "legendFormat": "{{severity_text}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": 120000,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ERROR"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "WARN"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "INFO"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "DEBUG"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 7
      },
      "id": 2
    },
