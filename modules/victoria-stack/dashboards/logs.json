    {
      "type": "table",
      "title": "Recurring messages",
      "description": "Messages grouped after masking numbers, IDs and addresses, most frequent first. A pattern you have not seen before is usually the start of a new problem.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "(k8s.namespace.name:$namespace k8s.pod.name:$pod severity_number:$level _msg:~\"$search\") or (host.name:$host unit:$unit severity_number:$level _msg:~\"$search\") | collapse_nums prettify | stats by (_msg) count() lines, count_uniq(_stream) sources, max(_time) last | sort by (lines desc) | limit 50",
          "queryType": "stats",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "_msg"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Message"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "lines"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Lines"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sources"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Sources"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "last"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Last"
              },
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              },
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": "",
          "countRows": false
        },
        "sortBy": [
