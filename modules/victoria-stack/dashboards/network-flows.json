    {
      "type": "table",
      "title": "Who connects to which port",
      "description": "Every source and the host port it reached, grouped. Service names the listener behind the port. Select a source to follow it, a host to open its detail page.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "conn.event:=new host.name:$host source.network:$network source.address:~\"$ip\" | stats by (source.address, source.network, geo.country_name, geo.city_name, host.name, destination.address, destination.port, destination.service, network.transport) count() connections | sort by (connections desc) | limit 300",
          "queryType": "stats",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "source.address"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Source"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Connections from ${__data.fields[\"source.address\"]}",
                    "url": "/d/network-flows?var-ip=${__data.fields[\"source.address\"]}&${__url_time_range}&${syncs:queryparam}&${rebuilds:queryparam}",
                    "targetBlank": false
                  },
                  {
                    "title": "Gateway requests from ${__data.fields[\"source.address\"]}",
                    "url": "/d/edge?var-client=${__data.fields[\"source.address\"]}&${__url_time_range}&${syncs:queryparam}&${rebuilds:queryparam}",
                    "targetBlank": false
                  },
                  {
                    "title": "Block ${__data.fields[\"source.address\"]} for 24 hours",
                    "url": "https://netguard.tailnet.bjoernblessin.de/block?value=${__data.fields[\"source.address\"]:percentencode}&duration=24h&reason=Inbound%20connections",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "source.network"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Network"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "geo.country_name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Country"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "geo.city_name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "City"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "host.name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Host"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Host detail for ${__data.fields[\"host.name\"]}",
                    "url": "/d/host?var-host=${__data.fields[\"host.name\"]}&${__url_time_range}&${syncs:queryparam}&${rebuilds:queryparam}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "destination.address"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Address"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "destination.port"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Port"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "destination.service"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Service"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "network.transport"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Protocol"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "connections"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Connections"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": "",
          "countRows": false
        },
        "sortBy": [
          {
            "displayName": "Connections",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns",
            "valueLabel": "__name__"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "source.address": 0,
              "source.network": 1,
              "geo.country_name": 2,
              "geo.city_name": 3,
              "host.name": 4,
              "destination.address": 5,
              "destination.port": 6,
              "destination.service": 7,
              "network.transport": 8,
              "connections": 9
            },
            "renameByName": {}
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 11
      },
      "id": 7
    },
    {
