{
  "uid": "network-flows",
  "title": "Network / Inbound connections",
  "description": "Who connects to what. Host firewalls log the first packet of every inbound connection with its source address, network and location, and the port and service it reached. Services on the host network, such as coturn and SSH, show up here and nowhere else. Select an address anywhere to follow it.",
  "tags": [
    "hh",
    "network",
    "security",
    "flows"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "refresh": "1m",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "links": [
    {
      "title": "Fleet overview",
      "type": "link",
      "url": "/d/fleet-overview?${syncs:queryparam}&${rebuilds:queryparam}",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "asDropdown": false,
      "targetBlank": false,
      "tags": [],
      "tooltip": "Start page: every host, service and signal at a glance"
    },
    {
      "title": "Dashboards",
      "type": "dashboards",
      "tags": [
        "hh"
      ],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    },
    {
      "title": "Gateway requests",
      "type": "link",
      "url": "/d/edge?${syncs:queryparam}&${rebuilds:queryparam}",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "asDropdown": false,
      "targetBlank": false,
      "tags": [],
      "tooltip": "HTTP requests through the Gateways, with their clients"
    },
    {
      "title": "In-cluster traffic",
      "type": "link",
      "url": "/d/cluster-network?${syncs:queryparam}&${rebuilds:queryparam}",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "asDropdown": false,
      "targetBlank": false,
      "tags": [],
      "tooltip": "Traffic that Cilium drops inside the cluster"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Argo CD syncs",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "enable": true,
        "hide": true,
        "iconColor": "purple",
        "expr": "(sum by (name, phase) (increase(argocd_app_sync_total{dry_run=\"false\",name!~\".+-mr-[0-9]+\"}[2m])) > 0 unless on (name) sum by (name) (increase(argocd_app_sync_total{dry_run=\"false\"}[1h])) > 6) and on () vector($syncs) > 0",
        "step": "2m",
        "titleFormat": "Sync {{name}}",
        "textFormat": "{{phase}}",
        "useValueForTime": false
      },
      {
        "name": "Host rebuilds",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "enable": true,
        "hide": true,
        "iconColor": "orange",
        "expr": "(max by (host_name, revision) (sysconf_installed_commit_time_seconds) unless max by (host_name, revision) (sysconf_installed_commit_time_seconds offset 15m)) and on () vector($rebuilds) > 0",
        "step": "5m",
        "titleFormat": "Rebuild {{host_name}}",
        "textFormat": "{{revision}}",
        "useValueForTime": false
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "victorialogs"
        },
        "query": {
          "type": "fieldValue",
          "field": "host.name",
          "query": "conn.event:*",
          "limit": 200,
          "refId": "VariableQuery"
        },
        "definition": "host.name where conn.event:*",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "description": "Hosts whose inbound connections to show.",
        "hide": 0,
        "regex": "",
        "options": [],
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "network",
        "label": "Source network",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "victorialogs"
        },
        "query": {
          "type": "fieldValue",
          "field": "source.network",
          "query": "conn.event:*",
          "limit": 200,
          "refId": "VariableQuery"
        },
        "definition": "source.network where conn.event:*",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "description": "Where the source address sits: the public internet, the house LAN or the tailnet.",
        "hide": 0,
        "regex": "",
        "options": [],
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "ip",
        "label": "Source address",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [
          {
            "selected": true,
            "text": "",
            "value": ""
          }
        ],
        "description": "Address or prefix to follow, for example 45.148. or 100.69.84.4. Empty shows every source.",
        "hide": 0
      },
      {
        "name": "syncs",
        "label": "Argo CD syncs",
        "type": "custom",
        "query": "shown : 1,hidden : 0",
        "multi": false,
        "includeAll": false,
        "description": "Marks each Argo CD sync on the time series.",
        "hide": 0,
        "current": {
          "selected": true,
          "text": "shown",
          "value": "1"
        },
        "options": [
          {
            "selected": true,
            "text": "shown",
            "value": "1"
          },
          {
            "selected": false,
            "text": "hidden",
            "value": "0"
          }
        ]
      },
      {
        "name": "rebuilds",
        "label": "Host rebuilds",
        "type": "custom",
        "query": "shown : 1,hidden : 0",
        "multi": false,
        "includeAll": false,
        "description": "Marks each NixOS rebuild on the time series.",
        "hide": 0,
        "current": {
          "selected": true,
          "text": "shown",
          "value": "1"
        },
        "options": [
          {
            "selected": true,
            "text": "shown",
            "value": "1"
          },
          {
            "selected": false,
            "text": "hidden",
            "value": "0"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "At a glance",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Connections",
      "description": "Inbound connections the host firewalls saw open over the selected range.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "conn.event:=new host.name:$host source.network:$network source.address:~\"$ip\" | stats count() connections",
          "queryType": "stats",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "id": 2
    },
