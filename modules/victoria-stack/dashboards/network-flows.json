{
  "uid": "network-flows",
  "title": "Network flows",
  "description": "Who connects to what. Host firewalls log the first packet of every inbound connection; the edge logs every HTTP request. Both carry the source address, its network and location, and the port and service it reached. Select an address anywhere to follow it.",
  "tags": [
    "hh",
    "network",
    "security",
    "flows"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "refresh": "1m",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "links": [
    {
      "title": "Fleet overview",
      "type": "link",
      "url": "/d/fleet-overview",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "asDropdown": false,
      "targetBlank": false,
      "tags": [],
      "tooltip": "Start page: every host, service and signal at a glance"
    },
    {
      "title": "Dashboards",
      "type": "dashboards",
      "tags": [
        "hh"
      ],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "victorialogs"
        },
        "query": {
          "type": "fieldValue",
          "field": "host.name",
          "query": "conn.event:*",
          "limit": 200,
          "refId": "VariableQuery"
        },
        "definition": "host.name where conn.event:*",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "description": "Hosts whose inbound connections to show.",
        "hide": 0,
        "regex": "",
        "options": [],
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "network",
        "label": "Source network",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "victorialogs"
        },
        "query": {
          "type": "fieldValue",
          "field": "source.network",
          "query": "conn.event:*",
          "limit": 200,
          "refId": "VariableQuery"
        },
        "definition": "source.network where conn.event:*",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "description": "Where the source address sits: the public internet, the house LAN or the tailnet.",
        "hide": 0,
        "regex": "",
        "options": [],
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "ip",
        "label": "Source address",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [
          {
            "selected": true,
            "text": "",
            "value": ""
          }
        ],
        "description": "Address or prefix to follow, for example 45.148. or 100.69.84.4. Empty shows every source.",
        "hide": 0
      }
    ]
  },
