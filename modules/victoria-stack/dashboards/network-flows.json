    {
      "type": "stat",
      "title": "Connections",
      "description": "Inbound connections the host firewalls saw open over the selected range.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "conn.event:=new host.name:$host source.network:$network source.address:~\"$ip\" | stats count() connections",
          "queryType": "stats",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
