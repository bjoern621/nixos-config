{
  "uid": "claude-bot",
  "title": "Claude Bot",
  "tags": ["claude-bot", "discord"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Questions (1h)",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "graphMode": "area",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(claude_bot_questions_total[1h])) or vector(0)",
          "legendFormat": "asked"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Answered (1h)",
      "description": "Blank rather than zero when nothing was asked: a share of no questions is not 0%, it is undefined.",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "min": 0,
          "max": 1,
          "noValue": "-",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.6 },
              { "color": "green", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(claude_bot_questions_total{outcome=\"answered\"}[1h])) / sum(increase(claude_bot_questions_total[1h]))",
          "legendFormat": "answered"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Refused (1h)",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 20 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(claude_bot_questions_total{outcome=~\"refused.*\"}[1h])) or vector(0)",
          "legendFormat": "refused"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "In flight",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "noValue": "0" },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(claude_bot_inflight) or vector(0)",
          "legendFormat": "in flight"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Queued",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 6 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(claude_bot_queue_depth) or vector(0)",
          "legendFormat": "queued"
        }
      ]
    },
    {
      "id": 6,
      "type": "gauge",
      "title": "Day budget used",
      "description": "Questions inside the rolling 24 hour window, against RATE_LIMIT_GLOBAL_PER_DAY as the bot reports it.",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "min": 0,
          "max": 1,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(claude_bot_global_budget_used{window=\"day\"}) / sum(claude_bot_global_budget_limit{window=\"day\"})",
          "legendFormat": "day"
        }
      ]
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Questions per hour by outcome",
      "description": "A trailing hour at every point, not a per-scrape rate. The bot answers a handful of questions an hour, and a window that short is empty between them.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "stacking": { "mode": "normal", "group": "A" },
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "answered" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "timeout" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(claude_bot_questions_total[1h]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Questions per hour by user",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (user_id) (increase(claude_bot_questions_total[1h]))",
          "legendFormat": "{{user_id}}"
        }
      ]
    },

    {
      "id": 20,
      "type": "timeseries",
      "title": "Global budget: used against the ceiling",
      "description": "The ceiling is read from the bot, not hardcoded, so a ConfigMap change moves the line.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*ceiling.*" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(claude_bot_global_budget_used{window=\"hour\"})",
          "legendFormat": "hour used"
        },
        {
          "refId": "B",
          "expr": "sum(claude_bot_global_budget_limit{window=\"hour\"})",
          "legendFormat": "hour ceiling"
        },
        {
          "refId": "C",
          "expr": "sum(claude_bot_global_budget_used{window=\"day\"})",
          "legendFormat": "day used"
        },
        {
          "refId": "D",
          "expr": "sum(claude_bot_global_budget_limit{window=\"day\"})",
          "legendFormat": "day ceiling"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Tokens left per user",
      "description": "Read every export interval, so the refill is a slope rather than a step. A vertical drop is a question; a flat line at the top is a full bucket. A user appears from their first question onward.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": ["lastNotNull", "min"]
        },
        "tooltip": { "mode": "multi", "sort": "asc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "claude_bot_user_tokens_remaining",
          "legendFormat": "{{user_id}}"
        }
      ]
    },

    {
      "id": 30,
      "type": "stat",
      "title": "Answer latency",
      "description": "Over the whole selected range, not per scrape interval. A quantile needs samples in its window, and on a bot answering a few questions an hour a short window is usually empty.",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 20 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "noValue": "no questions",
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name",
        "graphMode": "none",
        "colorMode": "none",
        "orientation": "horizontal",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (increase(claude_bot_question_duration_seconds_bucket[$__range])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.9, sum by (le) (increase(claude_bot_question_duration_seconds_bucket[$__range])))",
          "legendFormat": "p90"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (increase(claude_bot_question_duration_seconds_bucket[$__range])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 31,
      "type": "stat",
      "title": "Turns per question",
      "description": "Over the selected range. A question needing more turns is one where the model reached for a tool.",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 20 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "noValue": "no questions",
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name",
        "graphMode": "none",
        "colorMode": "none",
        "orientation": "horizontal",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (increase(claude_bot_claude_turns_bucket[$__range])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.9, sum by (le) (increase(claude_bot_claude_turns_bucket[$__range])))",
          "legendFormat": "p90"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(1, sum by (le) (increase(claude_bot_claude_turns_bucket[$__range])))",
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Concurrency and queue",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 20 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "sum(claude_bot_inflight)", "legendFormat": "in flight" },
        { "refId": "B", "expr": "sum(claude_bot_queue_depth)", "legendFormat": "queued" }
      ]
    },

    {
      "id": 40,
      "type": "timeseries",
      "title": "Discord tool calls per hour",
      "description": "The five channel-reading tools only. WebSearch and WebFetch run inside the Agent SDK subprocess and are not visible to the bot, so an empty panel next to a high turn count means the model searched the web rather than read the channel.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 25 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "min": 0,
          "noValue": "no tool calls yet",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "stacking": { "mode": "normal", "group": "A" },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool) (increase(claude_bot_tool_calls_total[1h]))",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "id": 41,
      "type": "stat",
      "title": "Tool latency p90",
      "description": "Over the selected range, per Discord tool.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 25 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "noValue": "no tool calls yet",
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name",
        "graphMode": "none",
        "colorMode": "none",
        "orientation": "horizontal"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.9, sum by (le, tool) (increase(claude_bot_tool_duration_seconds_bucket[$__range])))",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "Model tokens per hour",
      "description": "Cache reads dwarf the rest on a healthy conversation; input and output are what the subscription is actually spent on.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 25 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "noValue": "0",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["max"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (increase(claude_bot_claude_tokens_total[1h]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },

    {
      "id": 50,
      "type": "timeseries",
      "title": "Refusals per hour by reason",
      "description": "user_bucket is one person going too fast. global_hour and global_day are the whole server hitting the spend ceiling. refused_queue is the concurrency gate, not a rate limit. Empty means nothing has ever been refused: a counter that has never fired has no series to draw.",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 33 },
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "min": 0,
          "noValue": "nothing refused",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "stacking": { "mode": "normal", "group": "A" },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(claude_bot_questions_total{outcome=~\"refused.*\"}[1h]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },

    {
      "id": 60,
      "type": "logs",
      "title": "Bot events",
      "description": "One record per decision, carrying the user, the outcome and the exact refusal. Narrow with a field, for example: app:claude-bot AND limit_reason:user_bucket",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 40 },
      "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "app:claude-bot",
          "queryType": "instant",
          "maxLines": 100
        }
      ]
    }
  ]
}
