        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "query": "query_result(sum by (svc) (label_join(last_over_time(hubble_http_requests_total{destination_workload!=\"\"}[1d]), \"svc\", \"/\", \"destination_namespace\", \"destination_workload\")))",
        "definition": "query_result(sum by (svc) (label_join(last_over_time(hubble_http_requests_total{destination_workload!=\"\"}[1d]), \"svc\", \"/\", \"destination_namespace\", \"destination_workload\")))",
