        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "query": "label_values(hubble_http_requests_total, node)",
        "definition": "label_values(hubble_http_requests_total, node)",
        "regex": "",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "description": "Node whose Gateway Envoy served the request.",
        "hide": 0,
        "options": [],
        "allValue": ".*"
