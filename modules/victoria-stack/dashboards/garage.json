      "description": "Requests per second the Gateways passed to atticd and the Garage S3 endpoint, by status.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          },
          "expr": "sum by (svc, status) (label_join(rate(hubble_http_requests_total{destination_namespace=~\"atticd|garage\"}[$__rate_interval]), \"svc\", \"/\", \"destination_namespace\", \"destination_workload\"))",
          "legendFormat": "{{svc}} {{status}}",
          "refId": "A"
