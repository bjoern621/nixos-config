      "description": "Clients of the nix cache and its S3 endpoint by request count. Requests from the house's own public address are atticd fetching chunks for a client it streams to.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victorialogs"
          },
          "expr": "log.type:=access RequestHost:in(\"nix-cache.bjoernblessin.de\",\"s3.bjoernblessin.de\") | stats by (ClientHost, client.network, geo.country_name, RequestHost) count() requests, sum(DownstreamContentSize) bytes, count() if (DownstreamStatus:>=400) errors | sort by (requests desc) | limit 50",
          "queryType": "stats",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ClientHost"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Client"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Follow ${__data.fields.ClientHost}",
                    "url": "/d/network-flows?var-ip=${__data.fields.ClientHost}&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "client.network"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Network"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "geo.country_name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Country"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RequestHost"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Hostname"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "requests"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Requests"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "bytes"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Sent"
              },
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "errors"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "4xx and 5xx"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": "",
          "countRows": false
        },
        "sortBy": [
          {
            "displayName": "Requests",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns",
            "valueLabel": "__name__"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "ClientHost": 0,
              "client.network": 1,
              "geo.country_name": 2,
              "RequestHost": 3,
              "requests": 4,
              "bytes": 5,
              "errors": 6
            },
            "renameByName": {}
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 14,
        "h": 9
      },
      "id": 16
    },
    {
