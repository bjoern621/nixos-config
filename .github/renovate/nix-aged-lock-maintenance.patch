+/** Newest commit on `ref` of github.com `owner/repo` at or before `until`. null when none exists or the API call fails. */
+async function findCommitBefore(
+  owner: string,
+  repo: string,
+  ref: string | undefined,
+  until: string,
+): Promise<string | null> {
+  let url = `repos/${owner}/${repo}/commits?per_page=1&until=${until}`;
+  if (ref) {
+    url += `&sha=${ref}`;
+  }
+  try {
+    const { body } = await githubApi.getJsonUnchecked<{ sha: string }[]>(url);
+    return body[0]?.sha ?? null;
+  } catch (err) {
