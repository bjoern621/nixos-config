{
  # Laptop panel (eDP-1, scale 2): each tiled half 724 logical px wide.
  # Scales fit both apps side by side.
  # Discord min width 940px: 0.77 * 940 = 724.
  discord.commandLineArgs = "--force-device-scale-factor=0.77";
  # Spotify min width 800px: 0.905 * 800 = 724.
  spotify.commandLineArgs = "--force-device-scale-factor=0.905";
}
