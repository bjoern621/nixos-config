# Format reference for secrets/cyberghost.yaml, the encrypted file the CyberGhost VPN profiles read.
# This template is read by nothing.
#
# Edit the existing secret:  sops secrets/cyberghost.yaml
# Create it from scratch:    cp secrets/cyberghost.yaml.template secrets/cyberghost.yaml
#                            sops -e -i secrets/cyberghost.yaml
#
# Values come from one CyberGhost OpenVPN device config per country (ca.crt, client.crt, client.key)
# and the username and password that CyberGhost shows beside each download.
# All devices share one CA.
# Set a PEM file as one value: sops --set "[\"germany-key\"] $(jq -Rs . < client.key)" secrets/cyberghost.yaml

ca: REPLACE_CA_CRT_PEM
netherlands-cert: REPLACE_CLIENT_CRT_PEM
netherlands-key: REPLACE_CLIENT_KEY_PEM
netherlands-username: REPLACE_USERNAME
netherlands-password: REPLACE_PASSWORD
switzerland-cert: REPLACE_CLIENT_CRT_PEM
switzerland-key: REPLACE_CLIENT_KEY_PEM
switzerland-username: REPLACE_USERNAME
switzerland-password: REPLACE_PASSWORD
germany-cert: REPLACE_CLIENT_CRT_PEM
germany-key: REPLACE_CLIENT_KEY_PEM
germany-username: REPLACE_USERNAME
germany-password: REPLACE_PASSWORD
