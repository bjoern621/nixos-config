# Format reference for secrets/screenshare-relay.yaml, the encrypted file the relay reads.
# This template is read by nothing.
#
# Edit the value:    sops secrets/screenshare-relay.yaml
# Read it back:      sops -d --extract '["srt-passphrase"]' secrets/screenshare-relay.yaml
# Create from scratch (this destroys the existing value):
#                    cp secrets/screenshare-relay.yaml.template secrets/screenshare-relay.yaml
#                    sops -e -i secrets/screenshare-relay.yaml
#                    sops secrets/screenshare-relay.yaml
#
# srt-passphrase keys the SRT leg, the one the proxy cannot wrap: UDP, with no TLS of its
# own. MediaMTX writes it into both the publish and the read key (modules/mediamtx-relay.nix),
# and the app sends the same value on both legs, so a change here is a change in the app's
# relay settings too.
#
# MediaMTX refuses a passphrase shorter than 10 characters.

srt-passphrase: PLACEHOLDER_PASSPHRASE
