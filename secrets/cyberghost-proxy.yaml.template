# Format reference for secrets/cyberghost-proxy.yaml, the encrypted file the proxy tunnel reads.
# This template is read by nothing.
#
# Edit the existing secret:  sops secrets/cyberghost-proxy.yaml
# Create it from scratch:    cp secrets/cyberghost-proxy.yaml.template secrets/cyberghost-proxy.yaml
#                            sops -e -i secrets/cyberghost-proxy.yaml
#
# Values come from a CyberGhost OpenVPN device config (ca.crt, client.crt, client.key, credentials).
# Set a PEM file as one value: sops --set "[\"key\"] $(jq -Rs . < client.key)" secrets/cyberghost-proxy.yaml
# auth holds username and password on two lines, the format of OpenVPN's auth-user-pass file.

ca: REPLACE_CA_CRT_PEM
cert: REPLACE_CLIENT_CRT_PEM
key: REPLACE_CLIENT_KEY_PEM
auth: |
  REPLACE_USERNAME
  REPLACE_PASSWORD
