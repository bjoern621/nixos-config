# Format reference for secrets/crowdsec-bouncer.yaml, the encrypted file modules/blocklist.nix reads.
# This template is read by nothing.
#
# One firewall bouncer API key per host, keyed by hostname.
# sops-nix places only the host's own key in /run/secrets.
# Cluster LAPI registers each bouncer under the same name with the same key:
#   cscli bouncers add <hostname> --key <key>
#
# Print one key:  sops -d --extract '["<hostname>"]' secrets/crowdsec-bouncer.yaml
# Set one key:    sops --set '["<hostname>"] "<key>"' secrets/crowdsec-bouncer.yaml

netcup-g12: PLACEHOLDER_64_HEX
hetzner-hel1: PLACEHOLDER_64_HEX
vmk3s: PLACEHOLDER_64_HEX
